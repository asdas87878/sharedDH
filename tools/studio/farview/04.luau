	p.CFrame = CFrame.fromMatrix(Vector3.new(r[1], r[2], r[3]), Vector3.new(r[7], r[8], r[9]), Vector3.new(r[10], r[11], r[12]))
	p.Color = Color3.fromRGB(r[13], r[14], r[15])
	p.Parent = holder
end
holder.Parent = root
return string.format("far view file 4: %d parts", #rows)
