	p.Material = if NAMES[r[2] + 1] == "Glow" then Enum.Material.Neon else Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Color = Color3.fromRGB(bit32.rshift(r[4], 16), bit32.band(bit32.rshift(r[4], 8), 255), bit32.band(r[4], 255))
	p.CanCollide = bit32.band(r[5], 1) ~= 0
	p.CanTouch = p.CanCollide -- a part nothing can bump costs nothing in physics either (flags, glows, strips)
	p.CastShadow = bit32.band(r[5], 2) ~= 0
	if bit32.band(r[5], 4) ~= 0 then
		p.Transparency = 0.35
	elseif r[19] > 0 then
		p.Transparency = r[19]
	end
	p.Size = Vector3.new(r[9], r[10], r[11])
	p.CFrame = CFrame.fromMatrix(Vector3.new(r[6], r[7], r[8]), Vector3.new(r[12], r[13], r[14]), Vector3.new(r[15], r[16], r[17]))
	if r[18] == 1 or r[18] == 4 then
		picture(p, Enum.NormalId.Top, r[21], r[22], r[23], r[24])
	end
	if r[18] == 3 or r[18] == 4 then -- a wall's X axis points away from the lane, so Left faces it
		if r[25] then
			picture(p, Enum.NormalId.Left, r[25], r[26], r[27], r[28])
		else
			picture(p, Enum.NormalId.Left, 0, 0, 0, r[20]) -- slid so rows of squares sit on the same heights
		end
	end
	p.Parent = parent
	made += 1
end
return string.format("parts file 93 of 99: %d parts made", made)
