-- The buildings a person may move or delete by hand in Studio: every station, every plot, the landmark, the gate.
-- A rebuild keeps what was done by hand (2026-11-17: a rebuild put the user's own placing of the stations back to
-- the kit's, and it could not be got back). Each is stamped with where the kit built it (KitPivot); one that stands
-- somewhere else at the next build was moved by hand and its new copy goes there; one that is gone was deleted by
-- hand and stays gone. To have the kit's place or a deleted building back, clear the model's KitPivot attribute,
-- or take its name out of ClaudeBlockout's KitModels attribute.
local function tracked()
	local list = {}
	for _, name in { "Stations", "Plots" } do
		local folder = dock:FindFirstChild(name)
		if folder then
			for _, m in folder:GetChildren() do
				if m:IsA("Model") then
					list[name .. "/" .. m.Name] = m
				end
			end
		end
	end
	for _, name in { "Landmark", "Gate" } do
		local m = dock:FindFirstChild(name)
		if m and m:IsA("Model") then
			list[name] = m
		end
	end
	return list
end
local FOLDERS = { Stations = true, Dressing = true, Plots = true }
local BENCH = false -- on the bench every first name is a folder (a row of test pieces)
local function modelAt(path)
	local at = dock
	local first = true
	for name in string.gmatch(path, "[^/]+") do
		local nxt = at:FindFirstChild(name)
		if not nxt then
			nxt = Instance.new(if first and (BENCH or FOLDERS[name]) then "Folder" else "Model")
			nxt.Name = name
			nxt.Parent = at
		end
		at = nxt
		first = false
	end
	return at
end
