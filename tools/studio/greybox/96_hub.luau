--!nocheck
-- Generated by tools/map/greybox_luau.py: do not edit by hand. The words on the hub's start strip.
local WORDS = "DIVE IN"
local TURN = -90 -- the strip's top runs the short way across the picture, so the words are turned to lie along it;
-- -90 reads the right way up from inside the hub (90 is upside down)
local root = workspace:FindFirstChild("ClaudeBlockout")
assert(root, "the map isn't loaded")
local strip = root:FindFirstChild("StartStrip", true)
assert(strip, "no StartStrip")
for _, old in strip:GetChildren() do
	if old:IsA("SurfaceGui") then
		old:Destroy()
	end
end
local gui = Instance.new("SurfaceGui")
gui.Name = "Words"
gui.Face = Enum.NormalId.Top
gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
gui.PixelsPerStud = 4 -- coarse on purpose: text is at most 100 pixels tall, and this makes that about 25 studs
gui.LightInfluence = 1
local label = Instance.new("TextLabel")
label.Size = UDim2.fromOffset(strip.Size.X * 4 * 0.7, strip.Size.Z * 4 * 0.92) -- along the strip, across it
label.AnchorPoint = Vector2.new(0.5, 0.5)
label.Position = UDim2.fromScale(0.5, 0.5)
label.Rotation = TURN
label.BackgroundTransparency = 1
label.Text = WORDS
label.Font = Enum.Font.LuckiestGuy
label.TextScaled = true
label.TextColor3 = Color3.fromRGB(255, 255, 255)
local stroke = Instance.new("UIStroke")
stroke.Thickness = 7
stroke.Color = Color3.fromRGB(20, 30, 40)
stroke.Parent = label
label.Parent = gui
gui.Parent = strip
return "start strip says " .. WORDS
