},{"m":"Plots/Plot6","n":"Reef","p":[2774.54,7.45,-132.86],"x":[-0.0203,0.0,-0.9998],"y":[0.0,1.0,0.0],"s":[3.75,1.2,3.3],"c":[70,190,190],"f":0},{"m":"Plots/Plot6","n":"Reef","p":[2774.63,8.5,-132.91],"x":[-0.1045,0.0,-0.9945],"y":[0.0,1.0,0.0],"s":[2.1,0.9,1.8],"c":[89,221,221],"f":0},{"m":"Plots/Plot6","n":"Reef","p":[2772.6,4.7,-149.0],"x":[0.0,0.0,-1.0],"y":[0.0,1.0,0.0],"s":[3.2,1.4,2.4],"c":[150,152,166],"f":0},{"m":"Plots/Plot6","n":"Reef","p":[2772.6,9.0,-149.0],"x":[0.0,0.0,-1.0],"y":[0.0,1.0,0.0],"s":[3.4,7.6,0.72],"c":[170,120,230],"f":0},{"m":"Plots/Plot6","n":"Reef","p":[2772.6,8.14,-146.5],"x":[0.0,0.454,-0.891],"y":[-0.0,0.891,0.454],"s":[2.8,6.6,0.7],"c":[199,144,255],"f":0},{"m":"Plots/Plot6","n":"Reef","p":[2772.6,8.14,-151.5],"x":[0.0,-0.454,-0.891],"y":[0.0,0.891,-0.454],"s":[2.8,6.6,0.68],"c":[170,120,230],"f":0},{"m":"Plots/Plot6","n":"Reef","p":[2772.6,6.68,-145.31],"x":[0.0,0.788,-0.6157],"y":[-0.0,0.6157,0.788],"s":[2.2,4.8,0.66],"c":[199,144,255],"f":0},{"m":"Plots/Plot6","n":"Reef","p":[2772.6,6.68,-152.69],"x":[0.0,-0.788,-0.6157],"y":[0.0,0.6157,-0.788],"s":[2.2,4.8,0.64],"c":[170,120,230],"f":0},{"m":"Plots/Plot6","n":"Reef","p":[2774.1,5.26,-163.33],"x":[-0.5262,0.0,-0.8503],"y":[0.0,1.0,0.0],"s":[4.2,2.52,3.64],"c":[150,152,166],"f":0}]]==]) do
	local parent = modelAt(r.m)
	if r.fish then -- one of the game's own creatures, cloned: nothing in FishModels is changed
		local src = fishModels and fishModels:FindFirstChild(r.fish)
		if src then
			local m = src:Clone()
			m.Name = r.n
			for _, tag in CollectionService:GetTags(m) do
				CollectionService:RemoveTag(m, tag)
			end
			m:ScaleTo(r.k)
			local centre = m:GetBoundingBox().Position
			local head = m:FindFirstChild("Head", true)
			local back = head and head:IsA("BasePart") and head.Position.Z < centre.Z -- its nose is toward -Z as it is kept
			local from = CFrame.new(centre) * (if back then CFrame.Angles(0, math.pi, 0) else CFrame.identity)
			local to = CFrame.fromMatrix(Vector3.new(r.p[1], r.p[2], r.p[3]), Vector3.new(r.x[1], r.x[2], r.x[3]), Vector3.new(r.y[1], r.y[2], r.y[3]))
			m:PivotTo(to * from:Inverse() * m:GetPivot())
			for _, d in m:GetDescendants() do
				if d:IsA("BasePart") then
					d.Anchored = true
					d.CanCollide = false
					d.CanTouch = false
					d.CanQuery = false
					d.CastShadow = r.k >= 0.7
				end
			end
			m.Parent = parent
		else
			table.insert(missing, r.fish)
		end
		made += 1
		continue
	end
	if r.figure then -- a player-sized figure, for scale (the bench only): a copy of Workspace.ClaudeScaleFigure's first
		local folder = workspace:FindFirstChild("ClaudeScaleFigure")
		local src = folder and folder:FindFirstChildWhichIsA("Model")
		if src then
			local m = src:Clone()
			m.Name = "Figure"
			m:PivotTo(CFrame.new(r.p[1], r.p[2] + 3.406, r.p[3]) * CFrame.Angles(0, math.rad(r.figure), 0))
			m.Parent = parent
		end
		continue
	end
	local p = Instance.new("Part")
	p.Name = r.n
	p.Anchored = true
	p.Material = if r.mat == "Neon" then Enum.Material.Neon else Enum.Material.SmoothPlastic
	if r.mat == "Stud" then -- the stud picture as a material of our own: on every face, no sliding. Tried 2026-11-16:
		-- the map's picture is see-through shading to lay over a colour, and a material shows it as black, so this
		-- way needs a new, solid picture uploaded first
		local variants = game:GetService("MaterialService")
		if not variants:FindFirstChild("ClaudeStud") then
			local v = Instance.new("MaterialVariant")
			v.Name = "ClaudeStud"
			v.BaseMaterial = Enum.Material.SmoothPlastic
			v.ColorMap = TILE
			v.StudsPerTile = 16
			v.Parent = variants
		end
		p.MaterialVariant = "ClaudeStud"
	end
	if r.sh then
		p.Shape = Enum.PartType[r.sh]
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Color = rgb(r.c)
	p.CanCollide = bit32.band(r.f, 1) ~= 0
	p.CanTouch = p.CanCollide
	p.CanQuery = p.CanCollide
	p.CastShadow = bit32.band(r.f, 2) ~= 0
	p.Transparency = r.t or 0
	p.Size = Vector3.new(r.s[1], r.s[2], r.s[3])
	p.CFrame = CFrame.fromMatrix(Vector3.new(r.p[1], r.p[2], r.p[3]), Vector3.new(r.x[1], r.x[2], r.x[3]), Vector3.new(r.y[1], r.y[2], r.y[3]))
	if r.gui then
		words(p, r.gui)
	end
	if r.bill then -- a name floating over it, the same size from anywhere (sized in studs)
		local b = Instance.new("BillboardGui")
		b.Name = "Name"
		b.Size = UDim2.fromScale(r.bill.size[1], r.bill.size[2])
		b.MaxDistance = 900
		b.LightInfluence = 0
		local label = Instance.new("TextLabel")
		label.Name = "Text"
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = r.bill.text
		label.Font = Enum.Font.LuckiestGuy
		label.TextScaled = true
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextStrokeTransparency = 0
		label.TextStrokeColor3 = rgb(r.bill.colour):Lerp(Color3.new(0, 0, 0), 0.55)
		label.Parent = b
		b.Parent = p
	end
	if r.light then
		local l = Instance.new("PointLight")
		l.Range = r.light.range
		l.Brightness = r.light.bright
		l.Color = rgb(r.light.colour)
		l.Shadows = false
		l.Parent = p
	end
	if r.tex == "ripple" then -- the moving water: Dock.HubLife slides every picture tagged HubRipple
		local faces = if r.sh == "Cylinder" then { Enum.NormalId.Right } elseif r.n == "TankSurface" then { Enum.NormalId.Top, Enum.NormalId.Bottom } else { Enum.NormalId.Top } -- (a tank's is seen from under too, through the glass)
		for _, face in faces do
			local t = Instance.new("Texture")
			t.Name = "Ripple"
			t.Texture = "rbxassetid://6126332496"
			t.Face = face
			t.StudsPerTileU, t.StudsPerTileV = 24, 24
			t.Transparency = 0.3
			t.Parent = p
			CollectionService:AddTag(t, "HubRipple")
		end
	end
	if r.tex == "studs" and TILE ~= "" then -- on every face that can show (all but the underside), each lined up with the block
		local s = p.Size
		for _, f in { { Enum.NormalId.Top, s.X, s.Z }, { Enum.NormalId.Front, s.X, s.Y }, { Enum.NormalId.Back, s.X, s.Y },
			{ Enum.NormalId.Left, s.Z, s.Y }, { Enum.NormalId.Right, s.Z, s.Y } } do
			local t = Instance.new("Texture")
			t.Name = "Studs"
			t.Texture = TILE
			t.Face = f[1]
			t.StudsPerTileU, t.StudsPerTileV = 16, 16
			t.OffsetStudsU = slide(f[2], f[2] <= 8.01 and f[3] <= 8.01)
			t.OffsetStudsV = slide(f[3], false)
			t.Parent = p
		end
	end
	if r.tex == "stud" and TILE ~= "" then -- on its top only, lined up with the block
		local t = Instance.new("Texture")
		t.Name = "Studs"
		t.Texture = TILE
		t.Face = Enum.NormalId.Top
		t.StudsPerTileU, t.StudsPerTileV = 16, 16
		local small = p.Size.X <= 8.01 and p.Size.Z <= 8.01
		t.OffsetStudsU = slide(p.Size.X, small)
		t.OffsetStudsV = slide(p.Size.Z, false)
		t.Parent = p
	end
	p.Parent = parent
	-- a station's Model is placed by its ring, a trainer's by its body
	if (r.n == "Ring" and string.match(r.m, "^Stations/")) or (r.n == "TrainerRide" and string.match(r.m, "/TrainerRide$")) then
		parent.PrimaryPart = p
	end
	made += 1
end
root:SetAttribute("HubKitParts", (root:GetAttribute("HubKitParts") or 0) + made)
local lost = if #missing > 0 then "; NOT in FishModels: " .. table.concat(missing, ", ") else ""
return string.format("hub models: %d parts made%s", made, lost)
