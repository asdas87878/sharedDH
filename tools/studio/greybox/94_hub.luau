-- how far to slide the picture along one side of a top face: a side of 8 studs or less lies in one square (`first`
-- says which of the two tones); a longer one has a line of the checker through its middle
local function slide(size, first)
	if size <= 8.01 then
		return first and 8 or 0
	end
	return (-size / 2) % 8
end
local function rgb(c)
	return Color3.fromRGB(c[1], c[2], c[3])
end
-- words on a part's face. One line of text fills the face; `rows` makes that many empty lines for the game to fill
local function words(part, g)
	local lines = g.rows or 1
	local pps = math.clamp(96 / (part.Size.Y / lines), 4, 30)
	for _, face in FACES[g.face] do
		local gui = Instance.new("SurfaceGui")
		gui.Name = if g.rows then "Rows" else "Words"
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = pps
		gui.LightInfluence = 0
		if g.rows then
			local list = Instance.new("UIListLayout")
			list.SortOrder = Enum.SortOrder.LayoutOrder
			list.Parent = gui
		end
		for i = 1, lines do
			local label = Instance.new("TextLabel")
			label.Name = if g.rows then "Row" .. i else "Text"
			label.LayoutOrder = i
			label.Size = UDim2.fromScale(if g.rows then 1 else 0.92, if g.rows then 1 / lines else 0.86)
			label.AnchorPoint = if g.rows then Vector2.zero else Vector2.new(0.5, 0.5)
			label.Position = if g.rows then UDim2.new() else UDim2.fromScale(0.5, 0.5)
			label.BackgroundTransparency = 1
			label.Text = if g.rows then i .. ".   - - -" else g.text
			label.Font = Enum.Font.LuckiestGuy
			label.TextScaled = true
			label.TextColor3 = rgb(g.colour)
			if g.rows then
				label.TextXAlignment = Enum.TextXAlignment.Left
				local pad = Instance.new("UIPadding")
				pad.PaddingLeft = UDim.new(0.06, 0)
				pad.PaddingTop = UDim.new(0.14, 0)
				pad.PaddingBottom = UDim.new(0.14, 0)
				pad.Parent = label
			end
			if g.stroke then
				local stroke = Instance.new("UIStroke")
				stroke.Thickness = math.max(2, pps * 0.6)
				stroke.Color = rgb(g.stroke)
				stroke.Parent = label
			end
			label.Parent = gui
		end
		gui.Parent = part
	end
end
