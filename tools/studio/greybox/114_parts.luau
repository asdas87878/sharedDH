		else
			picture(p, Enum.NormalId.Left, 0, 0, 0, r[20]) -- slid so rows of squares sit on the same heights
		end
	end
	p.Parent = parent
	made += 1
end
return string.format("parts file 114 of 174: %d parts made", made)
