	p.Color = Color3.fromRGB(bit32.rshift(r[4], 16), bit32.band(bit32.rshift(r[4], 8), 255), bit32.band(r[4], 255))
	p.CanCollide = bit32.band(r[5], 1) ~= 0
	p.CastShadow = bit32.band(r[5], 2) ~= 0
	if bit32.band(r[5], 4) ~= 0 then
		p.Transparency = 0.35
	elseif r[19] > 0 then
		p.Transparency = r[19]
	end
	p.Size = Vector3.new(r[9], r[10], r[11])
	p.CFrame = CFrame.fromMatrix(Vector3.new(r[6], r[7], r[8]), Vector3.new(r[12], r[13], r[14]), Vector3.new(r[15], r[16], r[17]))
	if r[18] == 1 then
		picture(p, FLOOR, Enum.NormalId.Top, 20)
	elseif r[18] == 2 then
		picture(p, STUD, Enum.NormalId.Top, 4)
	elseif r[18] == 3 then
		picture(p, STUD, Enum.NormalId.Left, 4) -- a wall's X axis points away from the lane, so Left faces it
	end
	p.Parent = parent
	made += 1
end
return string.format("parts file 6 of 12: %d parts made", made)
