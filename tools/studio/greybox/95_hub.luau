local BENCH = false -- on the bench every first name is a folder (a row of test pieces)
local function modelAt(path)
	local at = dock
	local first = true
	for name in string.gmatch(path, "[^/]+") do
		local nxt = at:FindFirstChild(name)
		if not nxt then
			nxt = Instance.new(if first and (BENCH or FOLDERS[name]) then "Folder" else "Model")
			nxt.Name = name
			nxt.Parent = at
		end
		at = nxt
		first = false
	end
	return at
end
