-- how far to slide the picture along one side of a top face: a side of 8 studs or less lies in one square (`first`
-- says which of the two tones); a longer one has a line of the checker through its middle
local function slide(size, first)
	if size <= 8.01 then
		return first and 8 or 0
	end
	return (-size / 2) % 8
end
local function rgb(c)
