0,"sh":"Cylinder"},{"m":"Plots/Plot1","n":"SpringCoil","p":[2929.59,4.0,-215.0],"x":[0.0,1.0,0.0],"y":[-1.0,0.0,0.0],"s":[0.6,4.2,4.2],"c":[176,182,196],"f":0,"sh":"Cylinder"},{"m":"Plots/Plot1","n":"SpringCoil","p":[2929.59,5.0,-215.0],"x":[0.0,1.0,0.0],"y":[-1.0,0.0,0.0],"s":[0.6,4.2,4.2],"c":[176,182,196],"f":0,"sh":"Cylinder"},{"m":"Plots/Plot1/TrainerRide","n":"TrainerRide","p":[2929.59,5.9,-215.0],"x":[1.0,0.0,0.0],"y":[0.0,1.0,0.0],"s":[6,0.8,8],"c":[120,200,120],"f":2,"tex":"stud"},{"m":"Plots/Plot1/TrainerRide","n":"Toy","fish":"Seahorse","k":0.85,"p":[2929.59,12.13,-215.0],"x":[1.0,0.0,0.0],"y":[0.0,1.0,0.0]},{"m":"Plots/Plot1","n":"UpgradePost","p":[2917.59,3.32,-211.7],"x":[-1.0,0.0,-0.0],"y":[0.0,1.0,0.0],"s":[0.9,5.64,0.9],"c":[28,32,46],"f":3},{"m":"Plots/Plot1","n":"UpgradeBoard","p":[2917.59,6.14,-211.0],"x":[-1.0,0.0,-0.0],"y":[0.0,1.0,0.0],"s":[10.8,6.48,0.5],"c":[10,12,22],"f":1},{"m":"Plots/Plot2","n":"Pad","p":[2974.53,0.7,-258.0],"x":[1.0,0.0,0.0],"y":[0.0,1.0,0.0],"s":[56.0,0.4,112.0],"c":[120,200,120],"f":0,"t":1},{"m":"Plots/Plot2","n":"TankToe","p":[2974.53,-0.4,-270.0],"x":[1.0,0.0,0.0],"y":[0.0,1.0,0.0],"s":[53.0,0.6,85.0],"c":[96,160,96],"f":3,"tex":"studs"},{"m":"Plots/Plot2","n":"TankBase","p":[2974.53,0.9,-270.0],"x":[1.0,0.0,0.0],"y":[0.0,1.0,0.0],"s":[54.0,2,86.0],"c":[120,200,120],"f":3,"tex":"studs"},{"m":"Plots/Plot2","n":"BaseLine","p":[2974.53,1.35,-270.0],"x":[1.0,0.0,0.0],"y":[0.0,1.0,0.0],"s":[54.4,0.5,86.4],"c":[212,220,232],"f":0},{"m":"Plots/Plot2","n":"TankSand","p":[2974.53,2.15,-270.0],"x":[1.0,0.0,0.0],"y":[0.0,1.0,0.0],"s":[52.0,0.5,84.0],"c":[236,222,172],"f":3},{"m":"Plots/Plot2","n":"TankWater","p":[2974.53,18.4,-270.0],"x":[1.0,0.0,0.0],"y":[0.0,1.0,0.0],"s":[52.0,32,84.0],"c":[196,236,246],"f":0,"t":0.9},{"m":"Plots/Plot2","n":"TankSurface","p":[2950.53,34.15,-270.0],"x":[1.0,0.0,0.0],"y":[0.0,1.0,0.0],"s":[3.6,0.3,83.6],"c":[170,232,244],"f":0,"t":0.3,"tex":"ripple"}]]==]) do
	local parent = modelAt(r.m)
	if r.fish then -- one of the game's own creatures, cloned: nothing in FishModels is changed
		local src = fishModels and fishModels:FindFirstChild(r.fish)
		if src then
			local m = src:Clone()
			m.Name = r.n
			for _, tag in CollectionService:GetTags(m) do
				CollectionService:RemoveTag(m, tag)
			end
			m:ScaleTo(r.k)
			local centre = m:GetBoundingBox().Position
			local head = m:FindFirstChild("Head", true)
			local back = head and head:IsA("BasePart") and head.Position.Z < centre.Z -- its nose is toward -Z as it is kept
			local from = CFrame.new(centre) * (if back then CFrame.Angles(0, math.pi, 0) else CFrame.identity)
			local to = CFrame.fromMatrix(Vector3.new(r.p[1], r.p[2], r.p[3]), Vector3.new(r.x[1], r.x[2], r.x[3]), Vector3.new(r.y[1], r.y[2], r.y[3]))
			m:PivotTo(to * from:Inverse() * m:GetPivot())
			for _, d in m:GetDescendants() do
				if d:IsA("BasePart") then
					d.Anchored = true
					d.CanCollide = false
					d.CanTouch = false
					d.CanQuery = false
					d.CastShadow = r.k >= 0.7
				end
			end
			m.Parent = parent
		else
			table.insert(missing, r.fish)
		end
		made += 1
		continue
	end
	if r.figure then -- a player-sized figure, for scale (the bench only): a copy of Workspace.ClaudeScaleFigure's first
		local folder = workspace:FindFirstChild("ClaudeScaleFigure")
		local src = folder and folder:FindFirstChildWhichIsA("Model")
		if src then
			local m = src:Clone()
			m.Name = "Figure"
			m:PivotTo(CFrame.new(r.p[1], r.p[2] + 3.406, r.p[3]) * CFrame.Angles(0, math.rad(r.figure), 0))
			m.Parent = parent
		end
		continue
	end
	local p = Instance.new("Part")
	p.Name = r.n
	p.Anchored = true
	p.Material = if r.mat == "Neon" then Enum.Material.Neon else Enum.Material.SmoothPlastic
	if r.mat == "Stud" then -- the stud picture as a material of our own: on every face, no sliding. Tried 2026-11-16:
		-- the map's picture is see-through shading to lay over a colour, and a material shows it as black, so this
		-- way needs a new, solid picture uploaded first
		local variants = game:GetService("MaterialService")
		if not variants:FindFirstChild("ClaudeStud") then
			local v = Instance.new("MaterialVariant")
			v.Name = "ClaudeStud"
			v.BaseMaterial = Enum.Material.SmoothPlastic
			v.ColorMap = TILE
			v.StudsPerTile = 16
			v.Parent = variants
		end
		p.MaterialVariant = "ClaudeStud"
	end
	if r.sh then
		p.Shape = Enum.PartType[r.sh]
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Color = rgb(r.c)
	p.CanCollide = bit32.band(r.f, 1) ~= 0
	p.CanTouch = p.CanCollide
	p.CanQuery = p.CanCollide
	p.CastShadow = bit32.band(r.f, 2) ~= 0
	p.Transparency = r.t or 0
	p.Size = Vector3.new(r.s[1], r.s[2], r.s[3])
	p.CFrame = CFrame.fromMatrix(Vector3.new(r.p[1], r.p[2], r.p[3]), Vector3.new(r.x[1], r.x[2], r.x[3]), Vector3.new(r.y[1], r.y[2], r.y[3]))
	if r.gui then
		words(p, r.gui)
	end
	if r.bill and r.bill.sub then -- a station's name, style C: bare words like the fish tags (the user's pick; the
		-- UI chat's option C, tools/ui/hub_sign_options.luau), sized in studs so it keeps its size in the world
		local INK = Color3.fromRGB(16, 36, 63)
		local colour = rgb(r.bill.colour)
		local b = Instance.new("BillboardGui")
		b.Name = "Name"
		b.Size = UDim2.fromScale(r.bill.size[1], r.bill.size[2])
		b.MaxDistance = r.bill.far
		b.LightInfluence = 0
		local function line(name, text, font, y, high, edge)
			local label = Instance.new("TextLabel")
			label.Name = name
			label.BackgroundTransparency = 1
			label.Position = UDim2.fromScale(0, y)
			label.Size = UDim2.fromScale(1, high)
			label.Font = font
			label.Text = text
			label.TextColor3 = Color3.new(1, 1, 1)
			label.TextScaled = true
			local stroke = Instance.new("UIStroke")
			stroke.Thickness = edge
			stroke.Color = INK
			stroke.LineJoinMode = Enum.LineJoinMode.Round
			stroke.Parent = label
			label.Parent = b
			return label
		end
		local big = line("Text", r.bill.text, Enum.Font.GothamBlack, 0.02, 0.66, 3.5)
		local shade = Instance.new("UIGradient") -- the station's colour, lighter at the top
		shade.Color = ColorSequence.new(colour:Lerp(Color3.new(1, 1, 1), 0.7), colour:Lerp(Color3.new(1, 1, 1), 0.1))
		shade.Rotation = 90
		shade.Parent = big
		line("Sub", r.bill.sub, Enum.Font.FredokaOne, 0.7, 0.26, 2)
		b.Parent = p
	elseif r.bill then -- a name floating over it, the same size from anywhere (sized in studs)
		local b = Instance.new("BillboardGui")
		b.Name = "Name"
		b.Size = UDim2.fromScale(r.bill.size[1], r.bill.size[2])
		b.MaxDistance = 900
		b.LightInfluence = 0
		local label = Instance.new("TextLabel")
		label.Name = "Text"
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = r.bill.text
		label.Font = Enum.Font.LuckiestGuy
		label.TextScaled = true
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextStrokeTransparency = 0
		label.TextStrokeColor3 = rgb(r.bill.colour):Lerp(Color3.new(0, 0, 0), 0.55)
		label.Parent = b
		b.Parent = p
	end
	if r.circle then -- a station's mark on the floor: a circle's line with a see-through middle, drawn on the part's top
		local pps = 20
		local gui = Instance.new("SurfaceGui")
		gui.Name = "Circle"
		gui.Face = Enum.NormalId.Top
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = pps
		gui.LightInfluence = 1
		local edge = r.circle.edge * pps
		local fill = Instance.new("Frame")
		fill.Name = "Fill"
		fill.AnchorPoint = Vector2.new(0.5, 0.5)
		fill.Position = UDim2.fromScale(0.5, 0.5)
		fill.Size = UDim2.new(1, -2 * edge, 1, -2 * edge) -- the line is drawn outside the frame, so it ends at the part's edge
		fill.BackgroundColor3 = rgb(r.circle.colour)
		fill.BackgroundTransparency = 0.8 -- Dock.HubLife brings this down while a player stands on it
		fill.BorderSizePixel = 0
		local round = Instance.new("UICorner")
		round.CornerRadius = UDim.new(0.5, 0)
		round.Parent = fill
		local line = Instance.new("UIStroke")
		line.Thickness = edge
		line.Color = rgb(r.circle.colour)
		line.Parent = fill
		fill.Parent = gui
		gui.Parent = p
		CollectionService:AddTag(p, "HubRing")
	end
	if r.light then
		local l = Instance.new("PointLight")
		l.Range = r.light.range
		l.Brightness = r.light.bright
		l.Color = rgb(r.light.colour)
		l.Shadows = false
		l.Parent = p
	end
	if r.tex == "ripple" then -- the moving water: Dock.HubLife slides every picture tagged HubRipple
		local faces = if r.sh == "Cylinder" then { Enum.NormalId.Right } elseif r.n == "TankSurface" then { Enum.NormalId.Top, Enum.NormalId.Bottom } else { Enum.NormalId.Top } -- (a tank's is seen from under too, through the glass)
		for _, face in faces do
			local t = Instance.new("Texture")
			t.Name = "Ripple"
			t.Texture = "rbxassetid://6126332496"
			t.Face = face
			t.StudsPerTileU, t.StudsPerTileV = 24, 24
			t.Transparency = 0.3
			t.Parent = p
			CollectionService:AddTag(t, "HubRipple")
		end
	end
	if r.tex == "studs" and TILE ~= "" then -- on every face that can show (all but the underside), each lined up with the block
		local s = p.Size
		for _, f in { { Enum.NormalId.Top, s.X, s.Z }, { Enum.NormalId.Front, s.X, s.Y }, { Enum.NormalId.Back, s.X, s.Y },
			{ Enum.NormalId.Left, s.Z, s.Y }, { Enum.NormalId.Right, s.Z, s.Y } } do
			local t = Instance.new("Texture")
			t.Name = "Studs"
			t.Texture = TILE
			t.Face = f[1]
			t.StudsPerTileU, t.StudsPerTileV = 16, 16
			t.OffsetStudsU = slide(f[2], f[2] <= 8.01 and f[3] <= 8.01)
			t.OffsetStudsV = slide(f[3], false)
			t.Parent = p
		end
	end
	if r.tex == "stud" and TILE ~= "" then -- on its top only, lined up with the block
		local t = Instance.new("Texture")
		t.Name = "Studs"
		t.Texture = TILE
		t.Face = Enum.NormalId.Top
		t.StudsPerTileU, t.StudsPerTileV = 16, 16
		local small = p.Size.X <= 8.01 and p.Size.Z <= 8.01
		t.OffsetStudsU = slide(p.Size.X, small)
		t.OffsetStudsV = slide(p.Size.Z, false)
		t.Parent = p
	end
	p.Parent = parent
	-- a station's Model is placed by its ring, a trainer's by its body
	if (r.n == "Ring" and string.match(r.m, "^Stations/")) or (r.n == "TrainerRide" and string.match(r.m, "/TrainerRide$")) then
		parent.PrimaryPart = p
	end
	made += 1
end
root:SetAttribute("HubKitParts", (root:GetAttribute("HubKitParts") or 0) + made)
local lost = if #missing > 0 then "; NOT in FishModels: " .. table.concat(missing, ", ") else ""
return string.format("hub models: %d parts made%s", made, lost)
