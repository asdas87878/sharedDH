		p.Transparency = 0.35
	elseif r[19] > 0 then
		p.Transparency = r[19]
	end
	p.Size = Vector3.new(r[9], r[10], r[11])
	p.CFrame = CFrame.fromMatrix(Vector3.new(r[6], r[7], r[8]), Vector3.new(r[12], r[13], r[14]), Vector3.new(r[15], r[16], r[17]))
	if r[18] == 1 or r[18] == 4 then
		picture(p, Enum.NormalId.Top, r[21], r[22], r[23], r[24])
	end
	if r[18] == 3 or r[18] == 4 then -- a wall's X axis points away from the lane, so Left faces it
		if r[25] then
			picture(p, Enum.NormalId.Left, r[25], r[26], r[27], r[28])
		else
			picture(p, Enum.NormalId.Left, 0, 0, 0, r[20]) -- slid so rows of squares sit on the same heights
		end
	end
	p.Parent = parent
	made += 1
end
return string.format("parts file 86 of 92: %d parts made", made)
