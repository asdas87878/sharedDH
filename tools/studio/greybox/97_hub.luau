end
-- what was moved by hand goes back where it stood, what was deleted by hand is left out, and each building is
-- stamped with where the kit built it
local kept, left = 0, 0
do
	local keep = HttpService:JSONDecode(root:GetAttribute("KitKeep") or "[]")
	local goneList = root:GetAttribute("KitGone") or ""
	local list = tracked()
	for path in string.gmatch(goneList, "[^,]+") do
		if list[path] then
			list[path]:Destroy()
			list[path] = nil
			left += 1
		end
	end
	local names = {}
	for path, m in list do
		m:SetAttribute("KitPivot", m:GetPivot())
		if keep[path] then
			m:PivotTo(CFrame.new(table.unpack(keep[path])))
			kept += 1
		end
		table.insert(names, path)
	end
	for path in string.gmatch(goneList, "[^,]+") do
		table.insert(names, path) -- still on the list, so it stays gone at the next build too
	end
	root:SetAttribute("KitModels", table.concat(names, ","))
	root:SetAttribute("KitKeep", nil)
	root:SetAttribute("KitGone", nil)
end
-- the words on the start strip, lying on the floor, read from inside the hub
local strip = root:FindFirstChild("StartStrip", true)
assert(strip, "no StartStrip")
for _, old in strip:GetChildren() do
	if old:IsA("SurfaceGui") then
		old:Destroy()
	end
end
local gui = Instance.new("SurfaceGui")
gui.Name = "Words"
gui.Face = Enum.NormalId.Top
gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
gui.PixelsPerStud = 4 -- coarse on purpose: text is at most 100 pixels tall, and this makes that about 25 studs
gui.LightInfluence = 1
local label = Instance.new("TextLabel")
label.Size = UDim2.fromOffset(strip.Size.X * 4 * 0.7, math.min(strip.Size.Z * 4 * 0.92, strip.Size.X * 4 * 0.7 / 2.6)) -- along the strip, across it (no taller than a
-- line of it, or a narrow strip breaks DIVE IN onto two lines)
label.AnchorPoint = Vector2.new(0.5, 0.5)
label.Position = UDim2.fromScale(0.5, 0.5)
label.Rotation = -90 -- the strip's top runs the short way across the picture, so the words are turned to lie along it
label.BackgroundTransparency = 1
label.Text = "DIVE IN"
label.Font = Enum.Font.LuckiestGuy
label.TextScaled = true
label.TextColor3 = Color3.fromRGB(255, 255, 255)
local stroke = Instance.new("UIStroke")
stroke.Thickness = 7
stroke.Color = Color3.fromRGB(20, 30, 40)
stroke.Parent = label
label.Parent = gui
gui.Parent = strip
-- the hub's small movements, on each player's own machine
local life = Instance.new("Script")
life.Name = "HubLife"
life.RunContext = Enum.RunContext.Client
life.Source = [==[--!nocheck
-- Generated by tools/map/hub_luau.py: do not edit by hand. The hub's small movements, on this player's own machine:
-- the water on the tanks and in the pools slides (every Texture tagged HubRipple), and a station's circle on the floor
-- fills in while this player stands on it (every part tagged HubRing: its Circle.Fill).
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TILE = 24
local EMPTY, FULL, QUICK = 0.8, 0.35, 9 -- the circle's middle: how see-through off it and on it, and how fast it changes
local fills = {} -- ring part -> its Fill, found once
RunService.Heartbeat:Connect(function(dt)
	local t = os.clock()
	local u, v = (t * 1.3) % TILE, (t * 0.8) % TILE
	for _, picture in CollectionService:GetTagged("HubRipple") do
		picture.OffsetStudsU = u
		picture.OffsetStudsV = v
	end
	local character = Players.LocalPlayer and Players.LocalPlayer.Character
	local root = character and character.PrimaryPart
	for _, ring in CollectionService:GetTagged("HubRing") do
		local fill = fills[ring]
		if not fill then
			local gui = ring:FindFirstChild("Circle")
			fill = gui and gui:FindFirstChild("Fill")
			fills[ring] = fill
		end
		if fill then
			local on = false
			if root then
				local d = root.Position - ring.Position
				local reach = ring.Size.X / 2
				on = d.X * d.X + d.Z * d.Z < reach * reach and math.abs(d.Y) < 14
			end
			local want = if on then FULL else EMPTY
			local now = fill.BackgroundTransparency
			if math.abs(want - now) < 0.01 then
				if now ~= want then
					fill.BackgroundTransparency = want
				end
			else
				fill.BackgroundTransparency = now + (want - now) * math.min(1, dt * QUICK)
			end
		end
	end
end)
]==]
life.Parent = dock
local lost = if #missing > 0 then "; NOT in FishModels: " .. table.concat(missing, ", ") else ""
return string.format("hub models: %d parts made, %d in all; %d kept where they were moved by hand, %d left deleted; start strip says DIVE IN%s", made, root:GetAttribute("HubKitParts"), kept, left, lost)
