			local v = Instance.new("MaterialVariant")
			v.Name = "ClaudeStud"
			v.BaseMaterial = Enum.Material.SmoothPlastic
			v.ColorMap = TILE
			v.StudsPerTile = 16
			v.Parent = variants
		end
		p.MaterialVariant = "ClaudeStud"
	end
	if r.sh then
		p.Shape = Enum.PartType[r.sh]
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Color = rgb(r.c)
	p.CanCollide = bit32.band(r.f, 1) ~= 0
	p.CanTouch = p.CanCollide
	p.CanQuery = p.CanCollide
	p.CastShadow = bit32.band(r.f, 2) ~= 0
	p.Transparency = r.t or 0
	p.Size = Vector3.new(r.s[1], r.s[2], r.s[3])
	p.CFrame = CFrame.fromMatrix(Vector3.new(r.p[1], r.p[2], r.p[3]), Vector3.new(r.x[1], r.x[2], r.x[3]), Vector3.new(r.y[1], r.y[2], r.y[3]))
	if r.gui then
		words(p, r.gui)
	end
	if r.bill then -- a name floating over it, the same size from anywhere (sized in studs)
		local b = Instance.new("BillboardGui")
		b.Name = "Name"
		b.Size = UDim2.fromScale(r.bill.size[1], r.bill.size[2])
		b.MaxDistance = 900
		b.LightInfluence = 0
		local label = Instance.new("TextLabel")
		label.Name = "Text"
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = r.bill.text
		label.Font = Enum.Font.LuckiestGuy
		label.TextScaled = true
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextStrokeTransparency = 0
		label.TextStrokeColor3 = rgb(r.bill.colour):Lerp(Color3.new(0, 0, 0), 0.55)
		label.Parent = b
		b.Parent = p
	end
	if r.light then
		local l = Instance.new("PointLight")
		l.Range = r.light.range
		l.Brightness = r.light.bright
		l.Color = rgb(r.light.colour)
		l.Shadows = false
		l.Parent = p
	end
	if r.tex == "ripple" then -- the moving water: Dock.HubLife slides every picture tagged HubRipple
		local faces = if r.sh == "Cylinder" then { Enum.NormalId.Right } elseif r.n == "TankSurface" then { Enum.NormalId.Top, Enum.NormalId.Bottom } else { Enum.NormalId.Top } -- (a tank's is seen from under too, through the glass)
		for _, face in faces do
			local t = Instance.new("Texture")
			t.Name = "Ripple"
			t.Texture = "rbxassetid://6126332496"
			t.Face = face
			t.StudsPerTileU, t.StudsPerTileV = 24, 24
			t.Transparency = 0.3
			t.Parent = p
			CollectionService:AddTag(t, "HubRipple")
		end
	end
	if r.tex == "studs" and TILE ~= "" then -- on every face that can show (all but the underside), each lined up with the block
		local s = p.Size
		for _, f in { { Enum.NormalId.Top, s.X, s.Z }, { Enum.NormalId.Front, s.X, s.Y }, { Enum.NormalId.Back, s.X, s.Y },
			{ Enum.NormalId.Left, s.Z, s.Y }, { Enum.NormalId.Right, s.Z, s.Y } } do
			local t = Instance.new("Texture")
			t.Name = "Studs"
			t.Texture = TILE
			t.Face = f[1]
			t.StudsPerTileU, t.StudsPerTileV = 16, 16
			t.OffsetStudsU = slide(f[2], f[2] <= 8.01 and f[3] <= 8.01)
			t.OffsetStudsV = slide(f[3], false)
			t.Parent = p
		end
	end
	if r.tex == "stud" and TILE ~= "" then -- on its top only, lined up with the block
		local t = Instance.new("Texture")
		t.Name = "Studs"
		t.Texture = TILE
		t.Face = Enum.NormalId.Top
		t.StudsPerTileU, t.StudsPerTileV = 16, 16
		local small = p.Size.X <= 8.01 and p.Size.Z <= 8.01
		t.OffsetStudsU = slide(p.Size.X, small)
		t.OffsetStudsV = slide(p.Size.Z, false)
		t.Parent = p
	end
	p.Parent = parent
	-- a station's Model is placed by its ring, a trainer's by its body
	if (r.n == "Ring" and string.match(r.m, "^Stations/")) or (r.n == "TrainerRide" and string.match(r.m, "/TrainerRide$")) then
		parent.PrimaryPart = p
	end
	made += 1
end
root:SetAttribute("HubKitParts", (root:GetAttribute("HubKitParts") or 0) + made)
