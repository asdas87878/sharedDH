			label.Size = UDim2.fromScale(if g.rows then 1 else 0.92, if g.rows then 1 / lines else 0.86)
			label.AnchorPoint = if g.rows then Vector2.zero else Vector2.new(0.5, 0.5)
			label.Position = if g.rows then UDim2.new() else UDim2.fromScale(0.5, 0.5)
			label.BackgroundTransparency = 1
