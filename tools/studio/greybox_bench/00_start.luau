for _, zone in HttpService:JSONDecode([==[[{"Folder":"01_SHALLOWS","ZoneName":"SHALLOWS","Metres":0,"A":[9000.0,-46.0,0.0],"B":[9009.5,-80.5,984.0],"Width":188.5},{"Folder":"02_CORAL REEF","ZoneName":"CORAL REEF","Metres":10,"A":[9008.3,-81.5,1008.0],"B":[8746.4,-189.3,3449.5],"Width":279.1},{"Folder":"03_KELP FOREST","ZoneName":"KELP FOREST","Metres":40,"A":[8754.4,-190.5,3477.0],"B":[8879.6,-321.6,5896.4],"Width":364.2},{"Folder":"04_SHIPWRECKS","ZoneName":"SHIPWRECKS","Metres":80,"A":[8879.6,-321.6,5896.4],"B":[8537.2,-495.9,8332.6],"Width":378.3},{"Folder":"05_OPEN BLUE","ZoneName":"OPEN BLUE","Metres":150,"A":[8548.5,-497.6,8357.4],"B":[8283.3,-738.9,10775.0],"Width":448.3},{"Folder":"06_TWILIGHT","ZoneName":"TWILIGHT","Metres":200,"A":[8290.0,-740.9,10798.8],"B":[8822.4,-957.3,13204.0],"Width":513.3},{"Folder":"07_MIDNIGHT","ZoneName":"MIDNIGHT","Metres":1000,"A":[8821.2,-959.7,13229.4],"B":[9032.2,-1219.2,15659.6],"Width":559.8},{"Folder":"08_VENTS","ZoneName":"VENTS","Metres":2000,"A":[9042.3,-1221.9,15684.2],"B":[9329.8,-1564.0,18112.2],"Width":595.7},{"Folder":"09_BONE GRAVEYARD","ZoneName":"BONE GRAVEYARD","Metres":4000,"A":[9313.4,-1566.9,18135.9],"B":[9166.9,-1873.7,20619.8],"Width":669.8},{"Folder":"10_THE UNDERWORLD","ZoneName":"THE UNDERWORLD","Metres":6000,"A":[9166.9,-1873.7,20619.8],"B":[9000.8,-2223.9,23073.6],"Width":765.7}]]==]) do
	local f = Instance.new("Folder")
	f.Name = zone.Folder
	f:SetAttribute("ZoneName", zone.ZoneName)
	f:SetAttribute("Metres", zone.Metres)
	local a, b = Vector3.new(zone.A[1], zone.A[2], zone.A[3]), Vector3.new(zone.B[1], zone.B[2], zone.B[3])
	local mid = (a + b) / 2
	local floor = Instance.new("Part") -- the marker the game reads: the straight line from the land's start to its end
	floor.Name = "Floor"
	floor.Anchored = true
	floor.Transparency = 1
	floor.CanCollide = false
	floor.CanQuery = false
	floor.CanTouch = false
	floor.CastShadow = false
	floor.Size = Vector3.new(zone.Width, 1, (b - a).Magnitude)
	floor.CFrame = CFrame.lookAt(mid, mid - (b - a).Unit) * CFrame.new(0, -0.5, 0)
	floor.Parent = f
	f.Parent = dive
end
