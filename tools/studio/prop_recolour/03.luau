	if ok then
		for j, b in bricks do
			b.Color = Color3.fromHex(string.sub(row, j * 12 - 5, j * 12))
			painted += 1
		end
		done += 1
	else
		left += 1
	end
end
return string.format("%d models, %d bricks; left alone %d: %s", done, painted, left, table.concat(names, "; ", 1, math.min(5, #names)))
